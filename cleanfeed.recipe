#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
干净源 -> 电子书。

分工：
  n8n (https://n8n.nbhub.xyz/webhook/jin10) 负责 抓取 / 清洗 / 去重 / 排版，
  本 recipe 只负责把已经干净的 RSS 组织成一本书，不再做任何内容处理。

关键参数：
  use_embedded_content = True
      必须用 RSS 里现成的正文。关掉的话 Calibre 会去抓 <link>，
      而本源的 <link> 就是 webhook 地址，会把整份 RSS 抓回来当正文。
"""
from calibre.web.feeds.recipes import BasicNewsRecipe


class CleanFeed(BasicNewsRecipe):
    title = '财经快讯'
    description = '金十数据快讯（n8n 清洗去重后）'
    __author__ = 'a118382'
    language = 'zh'
    encoding = 'utf-8'

    # n8n 已按小时窗口过滤，这里放宽到 2 天兜底，避免时区偏差误杀
    oldest_article = 2
    max_articles_per_feed = 300

    use_embedded_content = True   # 见文件头说明，不要关
    remove_empty_feeds = True
    # 注意：不要开 ignore_duplicate_articles 的 url 判重 —— 本源各条目 link 同源
    no_stylesheets = True
    remove_javascript = True

    feeds = [
        ('财经快讯', 'https://n8n.nbhub.xyz/webhook/jin10'),
    ]
