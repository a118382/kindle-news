#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
金十数据 Telegram 频道 (jin10data) 快讯
源: https://my-tg-rss.ask-linsh.workers.dev/jin10data

处理要点:
  1. 时间窗口去重: 只取过去 oldest_article 天 (默认1天) 的快讯。
     每天北京 06:00 跑 → 取 昨天06:00~今天06:00, 已发过的不重复出现。
  2. 去掉「金十数据X月X日讯」前缀及残留「金十数据」四字 (书名 + 正文)。
  3. 兜底去重: 源偶尔把一条消息拆成「截断纯文本 + <b>完整段」,
     取最后一次出现的完整段, 避免正文重复两遍。
"""
import re
from calibre.web.feeds.recipes import BasicNewsRecipe
from calibre.ebooks.BeautifulSoup import BeautifulSoup
from datetime import datetime, timezone, timedelta

CST = timezone(timedelta(hours=8))


class Jin10Data(BasicNewsRecipe):
    title = '财经快讯'
    __author__ = 'lili'
    description = '金十数据 Telegram 频道快讯（几分钟一条）'
    language = 'zh'
    encoding = 'utf-8'

    oldest_article = 1            # 时间窗口去重: 只取过去24小时
    max_articles_per_feed = 300  # 一天数百条, 放宽上限避免截断
    no_stylesheets = True
    remove_javascript = True
    remove_empty_feeds = True
    resolve_internal_links = True

    feeds = [('财经快讯', 'https://my-tg-rss.ask-linsh.workers.dev/jin10data')]

    # ---------- 正文清理 ----------
    @staticmethod
    def _strip_prefix(text):
        # 去重: 「金十数据X月X日讯」出现多次 → 截断段+完整段拼接, 取最后一次起的完整段
        prefixes = list(re.finditer(r'金十数据\s*\d{1,2}月\d{1,2}日?\s*讯', text))
        if len(prefixes) >= 2:
            text = text[prefixes[-1].start():]
        # 去掉前缀及残留「金十数据」四字
        text = re.sub(r'金十数据\s*\d{1,2}月\d{1,2}日?\s*讯\s*[:：,]?', '', text)
        text = re.sub(r'金十数据', '', text)
        return text.strip()

    def _clean(self, html):
        soup = BeautifulSoup(html or '')
        for tag in soup.find_all(['img', 'a', 'i']):
            tag.decompose()
        text = soup.get_text(' ', strip=True)
        text = self._strip_prefix(text)
        text = re.sub(r'\s{2,}', ' ', text).strip()
        return '<p>' + text + '</p>' if text else '<p></p>'

    # ---------- 抓取并组织 ----------
    def parse_index(self):
        from calibre.web.feeds.feedparser import parse as feedparser_parse
        now = datetime.now(timezone.utc)
        articles = []
        for feed_title, url in self.feeds:
            try:
                raw = self.browser.open(url).read()
            except Exception as e:
                self.log.warn('抓取失败: %s' % e)
                continue
            d = feedparser_parse(raw)
            entries = []
            for e in d.entries:
                # 跳过频道封面主页 item (t.me/s 频道介绍页)
                _title = e.get('title', '') or ''
                _raw = ''
                if e.get('content'):
                    _raw = e['content'][0].get('value', '') or ''
                elif e.get('description'):
                    _raw = e['description']
                if ('Telegram' in _title) or ('tgme_page' in _raw):
                    continue
                pub = e.get('published_parsed') or e.get('updated_parsed')
                # 时间窗口去重: 超过 oldest_article 天的跳过
                if pub:
                    pdt = datetime(*pub[:6], tzinfo=timezone.utc)
                    age = (now - pdt).total_seconds() / 86400
                    if age > self.oldest_article:
                        continue
                    dt = pdt.astimezone(CST)
                    time_str = dt.strftime('%H:%M:%S')
                else:
                    time_str = '??:??:??'
                content = ''
                if e.get('content'):
                    content = e['content'][0].get('value', '')
                elif e.get('description'):
                    content = e['description']
                elif e.get('summary'):
                    content = e['summary']
                body = self._clean(content) if content else '<p></p>'
                entries.append({
                    'title': time_str,
                    'url': e.get('link', '') or 'https://t.me/s/jin10data',
                    'content': body,
                })
            articles.append((feed_title, entries))
        return articles
